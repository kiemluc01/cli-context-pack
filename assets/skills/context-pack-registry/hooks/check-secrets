#!/bin/sh
# Context Pack Registry: secret detection on staged changes (pre-commit).
#
# Scanner priority (use the project's scanner when it has one):
#   1. gitleaks (if installed)
#   2. detect-secrets-hook (if installed and .secrets.baseline exists)
#   3. built-in patterns below (fallback)
# Force one with AGENT_SECRET_SCANNER=gitleaks|detect-secrets|builtin.
#
# Built-in scanner:
#   - scans only ADDED lines of staged files
#   - blocks staging of secret-bearing files (.env, private keys)
#   - never prints a full secret (first 4 chars + asterisks)
#   - line allowlist: add the marker  context-pack-registry:allow-secret  on the line
#     (for test fixtures with fake credentials; visible in code review).
#     The pre-rename marker agent-registry:allow-secret is still accepted.
#   - file allowlist: shell globs in .agent/secret-allowlist (one per line)
# Exit codes: 0 pass, 1 blocked, 3 nothing to check.
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "check-secrets: not a git repository" >&2; exit 1; }
cd "$ROOT" || exit 1

STAGED=$(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR)
[ -n "$STAGED" ] || exit 3

SCANNER=${AGENT_SECRET_SCANNER:-auto}
ALLOW_FILE=.agent/secret-allowlist

if [ "$SCANNER" = auto ]; then
  if command -v gitleaks >/dev/null 2>&1; then SCANNER=gitleaks
  elif command -v detect-secrets-hook >/dev/null 2>&1 && [ -f .secrets.baseline ]; then SCANNER=detect-secrets
  else SCANNER=builtin; fi
fi

remediation() {
  echo "  FIX:    Remove the value from the change (git restore --staged <file>, edit, re-add),"
  echo "          load it from an environment variable or secret manager instead, and"
  echo "          ROTATE the credential if it was ever committed or pushed."
}

case "$SCANNER" in
  gitleaks)
    if gitleaks git --help >/dev/null 2>&1; then
      gitleaks git --pre-commit --staged --redact --no-banner . ; rc=$?
    else
      gitleaks protect --staged --redact --no-banner ; rc=$?
    fi
    if [ "$rc" -eq 0 ]; then echo "[PASS] Secret detection (gitleaks)"; exit 0; fi
    echo "[FAIL] Secret detection (gitleaks): findings above (values redacted)"
    echo "  REASON: Committed credentials are exposed to everyone with repository access and persist in history."
    remediation; exit 1 ;;
  detect-secrets)
    # shellcheck disable=SC2086
    printf '%s\n' "$STAGED" | tr '\n' '\0' | xargs -0 detect-secrets-hook --baseline .secrets.baseline; rc=$?
    if [ "$rc" -eq 0 ]; then echo "[PASS] Secret detection (detect-secrets)"; exit 0; fi
    echo "[FAIL] Secret detection (detect-secrets): findings above"
    echo "  REASON: Committed credentials are exposed to everyone with repository access and persist in history."
    remediation; exit 1 ;;
  builtin) ;;
  *) echo "check-secrets: unknown AGENT_SECRET_SCANNER=$SCANNER" >&2; exit 1 ;;
esac

# ---------------------------------------------------------------- built-in --

is_allowed_file() {
  [ -f "$ALLOW_FILE" ] || return 1
  while IFS= read -r pat || [ -n "$pat" ]; do
    case "$pat" in ''|'#'*) continue ;; esac
    # shellcheck disable=SC2254
    case "$1" in $pat) return 0 ;; esac
  done < "$ALLOW_FILE"
  return 1
}

# name|flags|ERE   (flags: i = case-insensitive, g = generic/placeholder-filtered)
PATTERNS='AWS access key ID|-|(^|[^A-Za-z0-9])(AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA|AIPA)[0-9A-Z]{16}
AWS secret access key|i|aws.{0,20}(secret|private).{0,20}[:=][[:space:]]*["'"'"']?[0-9A-Za-z/+]{40}
GitHub token|-|(^|[^A-Za-z0-9])gh[pousr]_[0-9A-Za-z]{36,}
GitHub fine-grained token|-|github_pat_[0-9A-Za-z_]{22,}
AI provider API key (sk-)|-|(^|[^A-Za-z0-9_-])sk-(ant-|proj-)?[0-9A-Za-z_-]{20,}
Slack token|-|(^|[^A-Za-z0-9])xox[abposr]-[0-9A-Za-z-]{10,}
Google API key|-|AIza[0-9A-Za-z_-]{35}
Stripe live key|-|(sk|rk)_live_[0-9A-Za-z]{20,}
Private key|-|-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----
JSON Web Token|-|eyJ[0-9A-Za-z_-]{10,}\.eyJ[0-9A-Za-z_-]{10,}\.[0-9A-Za-z_-]{10,}
Credential in connection URL|g|[A-Za-z][A-Za-z0-9+.-]*://[^:@/[:space:]]+:[^:@/[:space:]]{3,}@
Hard-coded secret assignment|ig|(password|passwd|pwd|secret|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret|jwt[_-]?secret|private[_-]?key)["'"'"']?[[:space:]]*[:=]+[[:space:]]*["'"'"'][^"'"'"'[:space:]]{8,}["'"'"']'

PLACEHOLDER_RE='\$\{|\{\{|<[A-Za-z_-]+>|process\.env|os\.environ|getenv|example|changeme|change_me|placeholder|dummy|redacted|your[_-]|xxxx|\*\*\*\*'

redact() { printf '%s' "$1" | sed 's/^[^A-Za-z0-9-]//' | cut -c1-4 | sed 's/$/************/'; }

findings=$(mktemp) || exit 1
added=$(mktemp) || exit 1
trap 'rm -f "$findings" "$added"' EXIT

# 1) Secret-bearing file names
printf '%s\n' "$STAGED" | while IFS= read -r f; do
  [ -n "$f" ] || continue
  is_allowed_file "$f" && continue
  b=$(basename "$f")
  case "$b" in
    .env.example|.env.sample|.env.template|.env.dist) continue ;;
    .env|.env.*|*.pem|*.key|*.p12|*.pfx|*.jks|*.keystore|id_rsa|id_dsa|id_ecdsa|id_ed25519|*.tfstate)
      printf '%s\t-\t%s\t%s\n' "$f" "Secret-bearing file type" "(whole file)" >> "$findings" ;;
  esac
done

# 2) Added lines: file<TAB>line<TAB>content. Header state avoids treating an
#    added line that starts with "++" as a file header.
git -c core.quotepath=off diff --cached -U0 --no-color --no-ext-diff \
    --src-prefix=a/ --dst-prefix=b/ --diff-filter=ACMR |
awk '
  /^diff --git / { hdr = 1; file = ""; next }
  hdr && /^\+\+\+ / { file = substr($0, 5); if (file == "/dev/null") file = ""; else sub(/^b\//, "", file); next }
  /^@@ / { hdr = 0; s = $0; sub(/^@@ -[0-9,]+ \+/, "", s); sub(/[ ,].*$/, "", s); line = s + 0; next }
  hdr { next }
  /^\+/ { if (file != "") printf "%s\t%d\t%s\n", file, line, substr($0, 2); line++; next }
' > "$added"

printf '%s\n' "$PATTERNS" | while IFS='|' read -r name flags re; do
  [ -n "$name" ] || continue
  gopt=-E; case "$flags" in *i*) gopt=-iE ;; esac
  grep $gopt -- "$re" "$added" 2>/dev/null | while IFS="$(printf '\t')" read -r f ln content; do
    case "$content" in *context-pack-registry:allow-secret*|*agent-registry:allow-secret*) continue ;; esac
    is_allowed_file "$f" && continue
    m=$(printf '%s\n' "$content" | grep -o $gopt -- "$re" | head -n 1)
    [ -n "$m" ] || continue
    case "$flags" in
      *g*) printf '%s\n' "$m" | grep -iEq -- "$PLACEHOLDER_RE" && continue ;;
    esac
    printf '%s\t%s\t%s\t%s\n' "$f" "$ln" "$name" "$(redact "$m")" >> "$findings"
  done
done

if [ ! -s "$findings" ]; then
  echo "[PASS] Secret detection (built-in patterns)"
  exit 0
fi

n=$(sort -u "$findings" | wc -l | tr -d ' ')
echo "[FAIL] Secret detection: $n likely secret(s) in staged changes"
sort -u "$findings" | while IFS="$(printf '\t')" read -r f ln name red; do
  if [ "$ln" = "-" ]; then echo "  FILE:   $f"; else echo "  FILE:   $f:$ln"; fi
  echo "  CHECK:  $name  [$red]"
done
echo "  REASON: Committed credentials are exposed to everyone with repository access,"
echo "          persist in git history, and can be copied into shared agent memory."
remediation
echo "          False positive? Add 'context-pack-registry:allow-secret' on that line, or a glob to $ALLOW_FILE."
exit 1
