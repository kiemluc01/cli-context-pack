{
  "name": "@aristha/ctxpack",
  "version": "0.3.0",
  "description": "Install and maintain the Context Pack Registry skill and its quality-gate hooks in any project.",
  "type": "module",
  "bin": {
    "ctxpack": "dist/bin.js"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
