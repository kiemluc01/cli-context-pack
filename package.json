    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiemluc01/cli-context-pack.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/kiemluc01/cli-context-pack/issues"
